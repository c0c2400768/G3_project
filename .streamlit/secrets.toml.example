# コピーして .streamlit/secrets.toml を作り、値を入れる（secrets.toml は .gitignore 済み）。
# Community Cloud では、アプリ設定の Secrets に同じ内容を貼る。GitHub には絶対に上げない。
[supabase]
url = "https://xxxxxxxx.supabase.co"
key = "service_role のキー"

[auth]
pepper = "長いランダムな文字列"

[gemini]
api_key = "Google AI Studio で作ったAPIキー"
# model = "gemini-3.6-flash"   # 省略可。無料枠で使えるモデル名は公式の料金表で確認する
# thinking_level = "low"        # 省略可。待ちを短くするなら low か minimal（minimal は使えないモデルがある）
